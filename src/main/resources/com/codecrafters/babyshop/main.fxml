<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.codecrafters.babyshop.MainController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: -color-accent-emphasis;">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <Label text="Baby Clothing Shop" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Admin" style="-fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ============ DASHBOARD ============ -->
            <Tab text="Dashboard">
                <VBox spacing="20">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Overview" styleClass="title-2"/>
                    <HBox spacing="16">
                        <VBox styleClass="elevated-1" spacing="6" HBox.hgrow="ALWAYS" prefHeight="110">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <Label text="Total Items in Stock" styleClass="text-muted"/>
                            <Label fx:id="totalItemsLabel" text="0" styleClass="title-1"/>
                        </VBox>
                        <VBox styleClass="elevated-1" spacing="6" HBox.hgrow="ALWAYS" prefHeight="110">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <Label text="Low Stock Items (&lt; 10)" styleClass="text-muted"/>
                            <Label fx:id="lowStockLabel" text="0" styleClass="title-1"/>
                        </VBox>
                        <VBox styleClass="elevated-1" spacing="6" HBox.hgrow="ALWAYS" prefHeight="110">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <Label text="Net Balance (Rs.)" styleClass="text-muted"/>
                            <Label fx:id="balanceLabel" text="0.00" styleClass="title-1"/>
                        </VBox>
                        <VBox styleClass="elevated-1" spacing="6" HBox.hgrow="ALWAYS" prefHeight="110">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <Label text="Salaries Pending (Rs.)" styleClass="text-muted"/>
                            <Label fx:id="pendingSalaryLabel" text="0.00" styleClass="title-1"/>
                        </VBox>
                    </HBox>
                    <Label text="Low Stock Alerts" styleClass="title-4"/>
                    <ListView fx:id="lowStockList" prefHeight="260"/>
                </VBox>
            </Tab>

            <!-- ============ INVENTORY ============ -->
            <Tab text="Inventory">
                <VBox spacing="14">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                    <Label text="Inventory / Stock Management" styleClass="title-2"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="codeField" promptText="Item code" prefWidth="100"/>
                        <TextField fx:id="nameField" promptText="Item name" prefWidth="200"/>
                        <TextField fx:id="sizeField" promptText="Size (e.g. 0-3M)" prefWidth="120"/>
                        <TextField fx:id="qtyField" promptText="Quantity" prefWidth="90"/>
                        <TextField fx:id="priceField" promptText="Price (Rs.)" prefWidth="110"/>
                        <Button text="Add New Item" styleClass="accent" onAction="#onAddItem"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Select a row, enter a quantity above, then:"/>
                        <Button text="+ Add Stock" onAction="#onAddStock"/>
                        <Button text="- Reduce Stock" onAction="#onReduceStock"/>
                        <Button text="Delete Item" styleClass="danger" onAction="#onDeleteItem"/>
                    </HBox>
                    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="invCodeCol" text="Code" prefWidth="100"/>
                            <TableColumn fx:id="invNameCol" text="Item Name" prefWidth="280"/>
                            <TableColumn fx:id="invSizeCol" text="Size" prefWidth="120"/>
                            <TableColumn fx:id="invQtyCol" text="Qty" prefWidth="100"/>
                            <TableColumn fx:id="invPriceCol" text="Price (Rs.)" prefWidth="140"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ============ FINANCE ============ -->
            <Tab text="Finance">
                <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="floating">

                    <!-- Transactions -->
                    <Tab text="Transactions (Income / Expense)">
                        <VBox spacing="14">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="trDescField" promptText="Description" prefWidth="260"/>
                                <ComboBox fx:id="trTypeBox" prefWidth="120"/>
                                <TextField fx:id="trAmountField" promptText="Amount (Rs.)" prefWidth="130"/>
                                <Button text="Add Transaction" styleClass="accent" onAction="#onAddTransaction"/>
                            </HBox>
                            <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="trDateCol" text="Date" prefWidth="140"/>
                                    <TableColumn fx:id="trDescCol" text="Description" prefWidth="320"/>
                                    <TableColumn fx:id="trTypeCol" text="Type" prefWidth="110"/>
                                    <TableColumn fx:id="trAmountCol" text="Amount (Rs.)" prefWidth="150"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- Salaries -->
                    <Tab text="Salary Payments">
                        <VBox spacing="14">
                            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="salNameField" promptText="Employee name" prefWidth="200"/>
                                <TextField fx:id="salRoleField" promptText="Role" prefWidth="150"/>
                                <TextField fx:id="salAmountField" promptText="Salary (Rs.)" prefWidth="130"/>
                                <Button text="Add Employee" onAction="#onAddEmployee"/>
                                <Button text="Mark Selected as Paid" styleClass="success" onAction="#onPaySalary"/>
                            </HBox>
                            <TableView fx:id="salaryTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="salNameCol" text="Employee" prefWidth="220"/>
                                    <TableColumn fx:id="salRoleCol" text="Role" prefWidth="160"/>
                                    <TableColumn fx:id="salAmountCol" text="Salary (Rs.)" prefWidth="150"/>
                                    <TableColumn fx:id="salStatusCol" text="Status" prefWidth="120"/>
                                </columns>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>

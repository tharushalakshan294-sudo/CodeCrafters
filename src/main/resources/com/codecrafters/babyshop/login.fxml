<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codecrafters.babyshop.LoginController" prefWidth="900" prefHeight="620">

    <!-- ============ LEFT: branding panel ============ -->
    <VBox alignment="CENTER" spacing="14" prefWidth="380" minWidth="380"
          style="-fx-background-color: linear-gradient(to bottom right, -color-accent-emphasis, -color-accent-fg);">
        <padding><Insets top="40" right="36" bottom="40" left="36"/></padding>

        <StackPane maxWidth="96" maxHeight="96" minWidth="96" minHeight="96"
                   style="-fx-background-color: rgba(255,255,255,0.18); -fx-background-radius: 48;">
            <Label text="👶" style="-fx-font-size: 46px;"/>
        </StackPane>
        <Label text="Baby Clothing Shop" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="Management System" style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 15px;"/>

        <Region prefHeight="18"/>

        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="250">
            <Label text="✓  Inventory &amp; stock control" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Label text="✓  Income &amp; expense tracking" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Label text="✓  Employee salary management" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
        </VBox>
    </VBox>

    <!-- ============ RIGHT: forms ============ -->
    <StackPane HBox.hgrow="ALWAYS" style="-fx-background-color: -color-bg-default;">

        <!-- LOGIN -->
        <VBox fx:id="loginPane" alignment="CENTER" spacing="14" maxWidth="340">
            <Label text="Welcome back" styleClass="title-2"/>
            <Label text="Sign in to continue to your dashboard" styleClass="text-muted"/>
            <Region prefHeight="10"/>

            <VBox spacing="5">
                <Label text="Username" styleClass="text-bold"/>
                <TextField fx:id="loginUserField" promptText="Enter your username" prefHeight="38"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Password" styleClass="text-bold"/>
                <PasswordField fx:id="loginPassField" promptText="Enter your password" prefHeight="38" onAction="#onLogin"/>
            </VBox>

            <Label fx:id="loginMsg" wrapText="true" style="-fx-text-fill: -color-danger-fg;"/>

            <Button text="Login" onAction="#onLogin" maxWidth="Infinity" prefHeight="40"
                    defaultButton="true" styleClass="accent"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" styleClass="text-muted"/>
                <Hyperlink text="Register" onAction="#showRegister"/>
            </HBox>
        </VBox>

        <!-- REGISTER -->
        <VBox fx:id="registerPane" alignment="CENTER" spacing="10" maxWidth="400" visible="false" managed="false">
            <Label text="Create account" styleClass="title-2"/>
            <Label text="Fill in your details to get started" styleClass="text-muted"/>
            <Region prefHeight="4"/>

            <VBox spacing="4">
                <Label text="Username *" styleClass="text-bold"/>
                <TextField fx:id="regUserField" promptText="Choose a username"/>
            </VBox>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Password *" styleClass="text-bold"/>
                    <PasswordField fx:id="regPassField" promptText="Password"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Confirm password *" styleClass="text-bold"/>
                    <PasswordField fx:id="regPass2Field" promptText="Repeat password"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Full name *" styleClass="text-bold"/>
                <TextField fx:id="regNameField" promptText="Your full name"/>
            </VBox>

            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Email" styleClass="text-bold"/>
                    <TextField fx:id="regEmailField" promptText="name@example.com"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Phone" styleClass="text-bold"/>
                    <TextField fx:id="regPhoneField" promptText="07X XXX XXXX"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Address" styleClass="text-bold"/>
                <TextField fx:id="regAddressField" promptText="Your address"/>
            </VBox>

            <Label fx:id="regMsg" wrapText="true" style="-fx-text-fill: -color-danger-fg;"/>

            <Button text="Create account" onAction="#onRegister" maxWidth="Infinity" prefHeight="40" styleClass="accent"/>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Already have an account?" styleClass="text-muted"/>
                <Hyperlink text="Login" onAction="#showLogin"/>
            </HBox>
        </VBox>
    </StackPane>
</HBox>
